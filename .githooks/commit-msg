#!/bin/sh
# commit-msg hook —— 校验提交信息符合 Conventional Commits 规范。
#
# 规则（与 AGENTS.md「Git 开发流程」一致）：
#   head 必须形如：type(scope): desc
#     type  限 feat|fix|docs|refactor|chore|test|build|ci|perf|style|revert
#     scope 可选（如 feat(bus): ...）
#     desc  非空，中文或英文皆可
#   放行 merge 提交（--no-ff 合并）与 revert 提交的默认信息。
#
# 校验失败时以非零退出码中止提交，错误信息指向 AGENTS.md。

MSG_FILE="$1"

# 跳过临时/异常提交信息
if [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

FIRST_LINE=$(grep -m1 '' "$MSG_FILE")
# 去掉结尾换行
FIRST_LINE=$(printf '%s' "$FIRST_LINE")

# 放行 merge / revert 自动生成的信息
case "$FIRST_LINE" in
    Merge*|Revert*)
        exit 0
        ;;
esac

# type(scope): desc
if ! printf '%s' "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|refactor|chore|test|build|ci|perf|style|revert)(\([a-z0-9-]+\))?: .+$'; then
    echo ""
    echo "提交信息不符合 Conventional Commits 格式："
    echo "  head 应形如：type(scope): 描述"
    echo "  type 允许：feat fix docs refactor chore test build ci perf style revert"
    echo "  示例：feat: 添加登录功能  或  fix(bus): 修复注册表竞态"
    echo "  规范详见 AGENTS.md「Git 开发流程」"
    echo ""
    exit 1
fi

exit 0
