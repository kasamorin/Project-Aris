# Aris 环境变量示例
# 复制为 .env 后按需填写（.env 不进 git，密钥只放这里）

# 日志级别：DEBUG / INFO / WARNING / ERROR
ARIS_LOG_LEVEL=INFO

# 数据目录（相对项目根目录）
ARIS_DATA_DIR=data

# --- LLM 连接 ---
# 总体超时预算（秒）：从发起请求开始计时，含多次 fallback 切换的耗时
ARIS_LLM_FALLBACK_TIMEOUT=30

# 所有提供方均失败时返回给用户界面/上层的提示语（不暴露原始报错）
ARIS_LLM_ERROR_MESSAGE=Someone tell Morin there's some problem with my AI.

# 各提供方的 API key（变量名需与 providers.toml 里 api_key_env 一致）
DEEPSEEK_API_KEY=
# OpenCode Zen 免费模型的 key（https://opencode.ai/auth 登录后获取）
OPENCODE_API_KEY=

# --- 联网搜索 ---
# Tavily 兜底搜索的 key（https://app.tavily.com 获取；不填则浏览器全失败时无兜底）
TAVILY_API_KEY=

